  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "lucide",
      "value": "flask-conical"
    }
  },
  "urls": {
    "repository": "https://github.com/CharTyr"
  }
