{
  "manifest_version": 2,
  "id": "chartyr.maiwork-probe",
  "version": "0.0.1",
  "name": "MaiWork M0 探针（临时）",
  "description": "MaiWork M0 契约验证用临时探针，仅作用于测试群，测完删除。",
  "plugin_type": "extension",
  "author": {
    "name": "CharTyr",
    "url": "https://github.com/CharTyr"
  },
  "license": "GPL-v3.0-or-later",
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "config.get",
    "chat.get_stream_by_group_id",
    "frequency.get_adjust",
